---
import { Search as SearchIcon } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="搜索 hhh电台的所有公开内容。" bodyClass="search-page">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <header class="plain-masthead search-masthead">
    <div class="wide-shell plain-masthead-grid">
      <div>
        <p class="eyebrow">SEARCH THE ARCHIVE</p>
        <h1>搜索</h1>
      </div>
      <p>搜索正文、标题和标签。索引完全在构建时生成，查询不会发送给外部服务。</p>
      <SearchIcon size={28} stroke-width={1.3} aria-hidden="true" />
    </div>
  </header>

  <section class="search-shell wide-shell">
    <div id="search" class="pagefind-container">
      <div class="search-loading">
        <span class="signal-light"></span>
        <p>正在调入本地索引...</p>
      </div>
    </div>
    <noscript>搜索需要启用 JavaScript，但其他页面均可直接阅读。</noscript>
  </section>
</BaseLayout>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    const target = document.querySelector("#search");
    if (window.PagefindUI && target) {
      target.innerHTML = "";
      new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: "输入关键词、标题或主题",
          clear_search: "清除",
          load_more: "加载更多",
          search_label: "搜索本站内容",
          filters_label: "筛选",
          zero_results: "没有找到 [SEARCH_TERM]",
          many_results: "找到 [COUNT] 条结果",
          one_result: "找到 1 条结果",
          alt_search: "没有找到 [SEARCH_TERM]。显示 [DIFFERENT_TERM] 的结果",
          search_suggestion: "没有找到 [SEARCH_TERM]。可以尝试：",
          searching: "正在搜索 [SEARCH_TERM]..."
        }
      });
      const params = new URLSearchParams(location.search);
      const query = params.get("q");
      if (query) {
        const input = target.querySelector("input");
        if (input) {
          input.value = query;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    } else if (target) {
      target.innerHTML = '<p class="search-dev-note">搜索索引会在 <code>npm run build</code> 后生成。请从本地预览地址打开此页。</p>';
    }
  });
</script>
