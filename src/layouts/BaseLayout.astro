---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import editorial from "../assets/images/editorial.webp";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  lang?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  image,
  type = "website",
  lang = site.locale,
  noindex = false,
  bodyClass = ""
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} / HHH RADIO`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image || editorial.src, Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0f0f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="hhh电台：研究、制作与漫游的个人刊物" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("hhh-theme");
        const theme = stored === "light" || stored === "dark"
          ? stored
          : (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("reveal-enabled");
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass} id="top">
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      const setupReveal = () => {
        const items = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)");
        if (!items.length || matchMedia("(prefers-reduced-motion: reduce)").matches) {
          items.forEach((item) => item.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (records) => records.forEach((record) => {
            if (record.isIntersecting) {
              (record.target as HTMLElement).classList.add("is-visible");
              observer.unobserve(record.target);
            }
          }),
          { threshold: 0.08, rootMargin: "0px 0px -3%" }
        );
        items.forEach((item) => observer.observe(item));
      };
      setupReveal();
      document.addEventListener("astro:page-load", setupReveal);
    </script>
  </body>
</html>
