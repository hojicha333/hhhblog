---
import { ArrowUpRight, Rss } from "@lucide/astro";
import { site } from "../data/site";
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-inner">
    <div class="footer-station">
      <span class="signal-light" aria-hidden="true"></span>
      <div>
        <strong>{site.englishName}</strong>
        <p>Independent signal / Since 2026</p>
      </div>
    </div>
    <nav aria-label="页脚导航">
      <a href="/archive/">归档</a>
      <a href="/about/">关于</a>
      <a href="/rss.xml">
        RSS <Rss size={13} aria-hidden="true" />
      </a>
      <a href="#top" aria-label="返回页首">
        返回页首 <ArrowUpRight size={13} aria-hidden="true" />
      </a>
    </nav>
    <p class="footer-note">文字与源码由普通文件组成。即使停更，它们也会安静留在这里。</p>
  </div>
</footer>
